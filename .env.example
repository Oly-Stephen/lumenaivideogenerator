# Copy to .env (worker/scripts) and apps/web/.env.local (web). Never commit real values.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=            # server-only
DATABASE_URL=   # Supabase > Connect > Session pooler URI: postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
APP_BASE_URL=http://localhost:3000

# --- fal.ai ---
FAL_KEY=
FAL_WEBHOOK_URL=                      # https://<project>.supabase.co/functions/v1/fal-webhook (empty in local dev => sweeper polls)
FAL_MAX_INFLIGHT=2
PROJECT_MAX_INFLIGHT=4
FAL_TOTAL_BUDGET_USD=9.00             # hard stop for the whole $10 test phase (D009)
GLOBAL_DAILY_SPEND_USD=3.00
PROVIDER_MODE=replay                  # live | replay | mock

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lumen-media
R2_PRESIGN_TTL_FAL_S=3600
R2_PRESIGN_TTL_VIEW_S=900

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Fish Audio ---
FISH_API_KEY=
FISH_MODEL=s2.1-pro-free              # s2.1-pro for production (D007)

# --- Model endpoints (fal) ---
TTS_FALLBACK_ENDPOINT=fal-ai/minimax/speech-2.8-hd
STT_ENDPOINT=fal-ai/elevenlabs/speech-to-text/scribe-v2
IMAGE_ENDPOINT=google/nano-banana-2.1/edit
VIDEO_STANDARD_ENDPOINT=minimax/h3/image-to-video
VIDEO_STANDARD_FALLBACK=alibaba/wan-3.0/image-to-video
VIDEO_PREMIUM_ENDPOINT=google/gemini-omni-flash/v1.1/reference-to-video
MUSIC_ENDPOINT=fal-ai/stable-audio-3/medium/text-to-audio

# --- Worker ---
FFMPEG_THREADS=4
RENDER_TMP_DIR=/tmp/lumen

# --- Guardrails ---
MAX_TEST_DURATION_S=30
MAX_SCENES_PER_PROJECT=12
TEST_KEYFRAME_RES=1K
TEST_MOTION_RES=480P
CREDIT_MARKUP=1.0
QA_MIN_STYLE=0.7
QA_MIN_CHARACTER=0.7
