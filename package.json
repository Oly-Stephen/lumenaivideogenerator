{
  "name": "lumen",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:worker": "npm run dev --workspace apps/worker",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "smoke:fal": "tsx scripts/smoke-fal.ts"
  },
  "dependencies": {
    "aws4fetch": "1.0.20"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "supabase": "2.118.0",
    "typescript": "6.0.3",
    "vite": "^8.3.0",
    "vitest": "5.0.2"
  }
}
