# Worker image: Node 22 + FFmpeg. Build from the repo root:
#   docker build -f infra/Dockerfile.worker -t whyfold-worker .
# Hosted on Railway (railway.json). Secrets come from the host's environment, never from the image.
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg fonts-dejavu-core ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json* .npmrc ./
COPY apps/worker/package.json apps/worker/
COPY packages/core/package.json packages/core/
COPY packages/prompts/package.json packages/prompts/
RUN npm install --workspace apps/worker --include-workspace-root --omit=dev --no-audit --no-fund

COPY packages/core packages/core
COPY packages/prompts packages/prompts
# R2 presigning is shared with the Edge Functions (storage.ts imports it).
COPY supabase/functions/_shared supabase/functions/_shared
COPY apps/worker apps/worker
COPY tsconfig.json ./

ENV NODE_ENV=production RENDER_TMP_DIR=/tmp/lumen PORT=8080 PROVIDER_MODE=live
EXPOSE 8080
USER node
CMD ["npx", "tsx", "apps/worker/src/index.ts"]
