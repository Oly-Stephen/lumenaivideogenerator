# Worker image: Node 22 + FFmpeg. Build from repo root:
#   docker build -f infra/Dockerfile.worker -t lumen-worker .
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg fonts-dejavu-core ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json* ./
COPY apps/worker/package.json apps/worker/
COPY packages/core/package.json packages/core/
RUN npm install --workspace apps/worker --include-workspace-root --omit=dev --no-audit --no-fund

COPY packages/core packages/core
COPY apps/worker apps/worker
COPY tsconfig.json ./

ENV NODE_ENV=production RENDER_TMP_DIR=/tmp/lumen PORT=8080
EXPOSE 8080
USER node
CMD ["npx", "tsx", "apps/worker/src/index.ts"]
